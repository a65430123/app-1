    {
      "name": "油漆刷、小滾筒"
    },
    {
      "name": "遮蔽膠帶、帆布"
    }
  ],
  "commonMistakes": [
    {
      "mistake": "鏽沒除乾淨",
      "consequence": "漆膜下再生鏽、起泡",
      "prevention": "除鏽到牢固面"
    },
    {
      "mistake": "直接在鍍鋅面上塗一般漆",
      "consequence": "漆膜剝落",
      "prevention": "使用鍍鋅面適用底漆"
    },
    {
      "mistake": "下雨天或濕度高時施工",
      "consequence": "附著不良、反白",
      "prevention": "選擇乾燥天氣"
    }
  ],
  "qcChecklist": [
