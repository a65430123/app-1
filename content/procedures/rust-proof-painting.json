  "title": "鐵件除鏽與防鏽塗裝",
  "summary": "鐵門、欄杆、鐵窗的除鏽與重新上漆",
  "tradeIds": [
    "painting",
    "steel"
  ],
  "overview": {
    "default": "將鐵件上的鏽與舊漆去除，清潔後塗防鏽底漆，再塗兩道面漆，延長鐵件壽命。",
    "beginner": "防鏽塗裝的關鍵在「除鏽」：鏽沒清乾淨就上漆，過不久會從漆底下再鏽出來。",
    "master": "除鏽（St 2/St 3 手工具或噴砂）→ 除油 → 防鏽底漆 → 面漆 2 道。"
  },
  "steps": [
    {
      "order": 1,
      "title": "保護周邊",
      "body": {
        "default": "地面與牆面以帆布、遮蔽膠帶保護。"
      }
    },
    {
      "order": 2,
      "title": "除鏽",
      "body": {
        "default": "以鋼刷、砂紙、電動鋼刷或砂輪片去除鏽斑與剝落舊漆，直到露出金屬面或牢固的舊漆。",
        "master": "去除浮鏽與鬆動舊漆，牢固舊漆打毛。"
      },
      "keyPoints": [
        "角落、接縫處最容易殘留鏽"
      ]
    },
    {
      "order": 3,
      "title": "清潔除油",
      "body": {
        "default": "清除粉塵，以溶劑或清潔劑去除油污，待乾燥。"
      }
    },
    {
      "order": 4,
      "title": "塗防鏽底漆",
      "body": {
        "default": "均勻塗佈防鏽底漆，鏽蝕嚴重處可補塗一道。"
      },
      "waitTime": "依產品乾燥時間"
    },
    {
      "order": 5,
      "title": "塗面漆",
      "body": {
        "default": "依產品說明塗 2 道面漆，兩道之間等乾燥。"
      },
      "waitTime": "依產品乾燥時間"
    }
  ],
  "materials": [
    {
      "name": "防鏽底漆",
