{
  "id": "self-leveling-floor",
  "type": "procedure",
  "version": "1.0.0",
  "updatedAt": "2026-11-09",
  "tags": [
    "泥作",
    "地坪"
  ],
  "difficulty": "intermediate",
  "title": "自平水泥地坪",
  "summary": "以自平水泥找平地面，作為木地板、塑膠地板的底層",
  "tradeIds": [
    "masonry",
    "interior"
  ],
  "overview": {
    "default": "清潔研磨地面、塗佈界面劑後，將拌好的自平水泥倒在地面，以刮板推開，讓它自行流平，形成平整的底層。",
    "beginner": "鋪木地板或塑膠地板前，地面越平，完成後越不會有踩起來咚咚響或凹凸的問題。",
    "master": "研磨清潔 → 修補 → 界面劑 → 定量攪拌 → 澆倒刮平 → 消泡 → 養護。"
  },
  "steps": [
    {
      "order": 1,
      "title": "基面處理",
      "body": {
        "default": "研磨去除浮漿、油污與起砂部分，大裂縫與坑洞先修補，吸塵清潔。"
      },
      "keyPoints": [
        "起砂地面一定要處理"
      ]
    },
    {
      "order": 2,
      "title": "塗佈界面劑",
      "body": {
        "default": "依產品說明塗佈底塗（界面劑），封住毛細孔並增加附著。",
        "beginner": "不塗界面劑，地面會把自平水泥的水吸走，產生氣泡和剝離。"
      },
      "waitTime": "依產品說明乾燥時間"
    },
    {
      "order": 3,
      "title": "攪拌",
      "body": {
        "default": "依產品標示的加水量，用電動攪拌器攪拌均勻。",
        "master": "精準加水量、攪拌至無結塊。"
      },
      "keyPoints": [
        "用量杯量水，不要憑感覺"
      ]
    },
    {
      "order": 4,
      "title": "澆倒與刮平",
      "body": {
        "default": "分區連續澆倒，以齒刮板推開到設定厚度，再用消泡滾筒滾壓。"
      },
      "specs": [
        {
          "label": "厚度",
          "value": "依產品，常見約 3–10 mm"
        }
      ],
      "keyPoints": [
        "前後兩批要在材料還能流動時接上，避免接痕"
      ]
    },
    {
      "order": 5,
      "title": "養護",
      "body": {
        "default": "施工中與完成後避免強風直吹與日曬，依產品時間後才可行走與鋪設地板。"
      },
      "waitTime": "可步行常見數小時；鋪設地板依產品與含水率"
    }
  ],
  "materials": [
    {
      "name": "自平水泥",
