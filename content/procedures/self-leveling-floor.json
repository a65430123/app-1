  "commonMistakes": [
    {
      "mistake": "沒有塗界面劑",
      "consequence": "起泡、剝離",
      "prevention": "依產品塗佈底塗"
    },
    {
      "mistake": "加水過多",
      "consequence": "表面起砂、強度不足、分層",
      "prevention": "依標示精準加水"
    },
    {
      "mistake": "一次倒太厚或太薄",
      "consequence": "開裂或無法流平",
      "prevention": "依產品建議厚度"
    }
  ],
  "qcChecklist": [
