  "commonMistakes": [
    {
      "mistake": "沒有打壓就封牆",
      "consequence": "日後漏水需打牆",
      "prevention": "封牆前打壓並記錄"
    },
    {
      "mistake": "熱水用 PVC 管",
      "consequence": "管材變形破裂",
      "prevention": "熱水用耐熱管材"
    },
    {
      "mistake": "熱水管未保溫",
      "consequence": "熱損失、出熱水慢",
      "prevention": "包覆保溫"
    },
    {
      "mistake": "不同金屬直接接觸",
      "consequence": "電位腐蝕",
      "prevention": "使用絕緣接頭"
    }
  ],
