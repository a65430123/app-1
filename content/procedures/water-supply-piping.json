  "tags": [
    "水電",
    "給水",
    "管路"
  ],
  "difficulty": "master",
  "title": "給水管配管與打壓試驗",
  "summary": "室內冷熱水管的配置、固定與完工前打壓測試",
  "tradeIds": [
    "electrical-plumbing"
  ],
  "overview": {
    "default": "依用水設備位置規劃冷熱水管路徑，選用適合的管材配管固定，熱水管做保溫，封牆前進行打壓試驗確認不漏水。",
    "beginner": "水管埋進牆裡就看不到了，萬一漏水要打牆修。所以「封牆前打壓」是最重要的檢查。",
    "master": "規劃 → 配管 → 固定 → 熱水保溫 → 打壓試驗 → 封牆 → 通水測試。"
  },
  "steps": [
    {
      "order": 1,
      "title": "管路規劃",
      "body": {
        "default": "依衛浴、廚房設備位置與出水高度，規劃冷熱水管路徑與管徑。"
      },
      "keyPoints": [
        "冷熱水管分開、熱水管越短越好",
        "預留檢修用的總開關"
      ]
    },
    {
      "order": 2,
      "title": "選管與配管",
      "body": {
        "default": "冷熱水管選用耐熱耐壓管材（如不鏽鋼壓接管、PPR 熱熔管），依接合方式施作。",
        "beginner": "PVC 管不耐熱，不能當熱水管。",
        "master": "熱水用不鏽鋼或 PPR，接合依各工法。"
      },
      "keyPoints": [
        "接頭依原廠工法壓接或熱熔"
      ]
    },
    {
      "order": 3,
      "title": "固定與保護",
      "body": {
        "default": "以管夾固定，穿過結構或牆面處加套管，熱水管包覆保溫。"
      }
    },
    {
      "order": 4,
      "title": "打壓試驗",
      "body": {
        "default": "封口後以打壓泵加壓，靜置觀察壓力錶是否下降。",
        "beginner": "把水管灌滿水加壓，放一段時間，壓力沒有掉就代表沒漏。",
        "master": "依規範或契約試驗壓力與時間，記錄壓力錶讀數並拍照。"
      },
      "specs": [
        {
          "label": "試驗壓力與時間",
          "value": "依規範或契約（常見加壓約 10 kgf/cm²，維持一段時間觀察）"
        }
      ],
      "keyPoints": [
        "拍照記錄開始與結束的壓力錶讀數"
      ]
    },
    {
      "order": 5,
      "title": "封牆與通水",
      "body": {
        "default": "打壓通過後才可封牆、粉刷，完工後通水檢查各出水口與接頭。"
      }
    }
  ],
  "materials": [
