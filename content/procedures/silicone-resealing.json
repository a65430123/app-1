  "difficulty": "beginner",
  "title": "浴室矽利康重新施打",
  "summary": "去除發霉舊矽利康並重新施打，屋主也能自己做",
  "tradeIds": [
    "waterproofing",
    "interior"
  ],
  "overview": {
    "default": "刮除發霉或剝離的舊矽利康，清潔乾燥後貼上遮蔽膠帶，打上防霉矽利康並刮平，撕除膠帶後等待固化。",
    "beginner": "浴缸邊、洗手台邊黑黑的通常是矽利康發霉，重打一次就會很乾淨。做好的關鍵是「乾燥」和「貼膠帶」。",
    "master": "刮除 → 除霉清潔 → 乾燥 → 遮蔽 → 打膠 → 刮平 → 撕膠帶 → 固化。"
  },
  "steps": [
    {
      "order": 1,
      "title": "刮除舊膠",
      "body": {
        "default": "以刮刀或美工刀把舊矽利康完全刮除，殘膠用去膠劑處理。"
      }
    },
    {
      "order": 2,
      "title": "除霉清潔",
      "body": {
        "default": "以除霉劑或稀釋漂白水清潔，再用清水擦淨。"
      }
    },
    {
      "order": 3,
      "title": "完全乾燥",
      "body": {
        "default": "接縫要完全乾燥，可用吹風機輔助。",
        "beginner": "有水氣的話矽利康黏不牢，很快就會脫落。"
      },
      "waitTime": "建議至少數小時"
    },
    {
      "order": 4,
      "title": "貼遮蔽膠帶",
      "body": {
        "default": "在接縫兩側貼上紙膠帶，留出要打膠的寬度。"
      }
    },
    {
      "order": 5,
      "title": "打膠與刮平",
      "body": {
        "default": "以膠槍連續打膠，再用刮板或沾肥皂水的手指一次刮平。"
      },
      "keyPoints": [
        "打膠要連續，不要斷斷續續"
      ]
    },
    {
      "order": 6,
      "title": "撕膠帶與固化",
      "body": {
        "default": "趁膠未乾時撕除膠帶，固化期間不要碰水。"
      },
      "waitTime": "依產品，常見 24 小時內避免碰水"
    }
  ],
