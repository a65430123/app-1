    },
    {
      "name": "捲尺"
    }
  ],
  "commonMistakes": [
    {
      "mistake": "坡度不足或倒坡",
      "consequence": "積水、堵塞",
      "prevention": "以水平尺確認每段坡度"
    },
    {
      "mistake": "直角急轉",
      "consequence": "容易卡住堵塞",
      "prevention": "用 45° 彎頭組合"
    },
    {
      "mistake": "施工時沒封管口",
      "consequence": "砂漿掉入堵塞",
      "prevention": "全程封口"
    },
    {
      "mistake": "缺存水彎",
      "consequence": "下水道臭味上來",
      "prevention": "每個排水點確認防臭"
    }
  ],
  "qcChecklist": [
