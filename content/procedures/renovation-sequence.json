  "commonMistakes": [
    {
      "mistake": "先做木作再做水電",
      "consequence": "木作要拆掉重來",
      "prevention": "先藏後露"
    },
    {
      "mistake": "浴室沒試水就貼磚",
      "consequence": "漏水需打掉重做",
      "prevention": "防水試水後再貼磚"
    },
