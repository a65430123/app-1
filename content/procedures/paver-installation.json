  "difficulty": "intermediate",
  "title": "連鎖磚鋪設",
  "summary": "庭院步道、停車位的連鎖磚鋪面施工",
  "tradeIds": [
    "landscape"
  ],
  "overview": {
    "default": "開挖整地後，分層鋪設級配並夯實作為基層，設置收邊石，鋪砂墊層刮平，鋪設連鎖磚後灑砂掃縫，以平板夯實機壓實。",
    "beginner": "連鎖磚會不會凹陷，看的是底下的「基層」有沒有夯實，表面的磚只是最後一層。",
    "master": "開挖 → 級配分層夯實 → 收邊石 → 砂墊層 → 鋪磚 → 灑砂掃縫 → 夯實。"
  },
  "steps": [
    {
      "order": 1,
      "title": "放樣與開挖",
      "body": {
        "default": "標出範圍與完成面高程，開挖至設計深度，並規劃排水坡度。"
      },
      "specs": [
        {
          "label": "排水坡度",
          "value": "依設計，避免積水"
        }
      ]
    },
    {
      "order": 2,
      "title": "基層",
      "body": {
        "default": "分層鋪設級配料並以夯實機夯實。",
        "master": "分層夯實，每層厚度依機具能力。"
      },
      "keyPoints": [
        "車行區域基層需加厚"
      ]
    },
    {
      "order": 3,
      "title": "收邊石",
      "body": {
        "default": "沿邊緣設置收邊石並以混凝土固定，防止磚向外推移。"
      }
    },
    {
      "order": 4,
      "title": "砂墊層",
      "body": {
        "default": "鋪設砂墊層並以刮尺刮平，鋪好後不要踩踏。"
      },
      "specs": [
        {
          "label": "砂墊層厚度（常見）",
          "value": "約 3–5 cm"
        }
      ]
    },
    {
      "order": 5,
      "title": "鋪磚",
      "body": {
        "default": "依花樣鋪設連鎖磚，邊緣切磚補齊。"
      }
    },
    {
      "order": 6,
      "title": "灑砂與夯實",
      "body": {
        "default": "灑細砂掃入磚縫，以平板夯實機壓實，再補砂掃縫。"
      }
    }
  ],
