  "commonMistakes": [
    {
      "mistake": "龍骨貼地",
      "consequence": "潮濕腐朽、白蟻",
      "prevention": "墩座架高、保持通風"
    },
    {
      "mistake": "面板不留縫",
      "consequence": "拱起、積水",
      "prevention": "依產品留縫"
    },
    {
      "mistake": "使用一般鐵螺絲",
      "consequence": "鏽蝕、黑色鏽痕",
      "prevention": "使用不鏽鋼螺絲"
    },
    {
      "mistake": "沒有定期上油",
      "consequence": "龜裂、褪色",
      "prevention": "每 1–2 年補塗護木油"
    }
  ],
  "qcChecklist": [
