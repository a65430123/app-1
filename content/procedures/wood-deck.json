  "difficulty": "intermediate",
  "title": "戶外木平台",
  "summary": "以防腐木或塑木搭建戶外木平台",
  "tradeIds": [
    "landscape",
    "carpentry"
  ],
  "overview": {
    "default": "設置基礎墩座，架設龍骨並調平，再鋪設面板並留伸縮縫，以不鏽鋼螺絲固定，最後塗佈護木油（防腐木）。",
    "beginner": "戶外木平台最怕積水與通風不良，龍骨不能直接貼在潮濕地面上，面板之間也要留縫。",
    "master": "放樣 → 基礎墩 → 龍骨（調平、坡度）→ 面板留縫 → 不鏽鋼螺絲 → 切口防腐 → 護木油。"
  },
  "steps": [
    {
      "order": 1,
      "title": "放樣與基礎",
      "body": {
        "default": "放樣範圍，設置混凝土墩座或可調式支撐，使龍骨離地。"
      },
      "keyPoints": [
        "龍骨不可直接放在泥土上"
      ]
    },
    {
      "order": 2,
      "title": "龍骨",
      "body": {
        "default": "架設龍骨並調平，預留微小排水坡度。"
      },
      "specs": [
        {
          "label": "龍骨間距（常見）",
          "value": "約 40–60 cm（依面板厚度與產品）"
        }
      ]
    },
    {
      "order": 3,
      "title": "鋪面板",
      "body": {
        "default": "面板之間留縫，方便排水與熱脹冷縮。",
        "beginner": "木頭遇水會膨脹、乾了會收縮，不留縫會拱起來。"
      },
      "specs": [
        {
          "label": "面板間隙（常見）",
          "value": "約 5 mm（依材料與產品說明）"
        }
      ]
    },
    {
      "order": 4,
      "title": "固定",
      "body": {
        "default": "以不鏽鋼螺絲固定，先預鑽孔避免木材裂開。"
      },
      "keyPoints": [
        "一般鐵螺絲會生鏽並在木頭上留下黑色鏽痕"
      ]
    },
    {
      "order": 5,
      "title": "切口防腐與塗裝",
      "body": {
        "default": "防腐木的切口補塗防腐劑，完成後塗護木油（塑木免塗）。"
      },
      "waitTime": "依產品乾燥時間"
    }
  ],
