{
  "id": "wall-repainting",
  "type": "procedure",
  "version": "1.0.0",
  "updatedAt": "2026-11-09",
  "tags": [
    "油漆",
    "牆面",
    "居家"
  ],
  "difficulty": "beginner",
  "title": "室內牆面重新粉刷",
  "summary": "舊牆面的修補、批土、研磨與乳膠漆塗刷",
  "tradeIds": [
    "painting"
  ],
  "overview": {
    "default": "保護家具與地面後，刮除剝落舊漆、修補裂縫孔洞、批土研磨，再塗底漆與兩道面漆。",
    "beginner": "油漆好不好看，七成在「前置作業」：批土、研磨做得好，漆才會平順。這也是屋主最常自己動手的項目。",
    "master": "遮蔽 → 刮除 → 修補批土 → 研磨 → 底漆 → 面漆 2 道 → 收尾。"
  },
  "steps": [
    {
      "order": 1,
      "title": "遮蔽保護",
      "body": {
        "default": "移開或覆蓋家具，地面鋪保護材，插座蓋板拆下，門框、踢腳板貼遮蔽膠帶。"
      }
    },
    {
      "order": 2,
      "title": "刮除與修補",
      "body": {
        "default": "刮除起泡、剝落的舊漆，裂縫與孔洞以批土填補；壁癌處需先找出水源處理。",
        "beginner": "壁癌是牆裡有水分，只刷油漆蓋過去，很快又會長出來。"
      },
      "keyPoints": [
        "有壁癌先處理漏水源"
      ]
    },
    {
      "order": 3,
      "title": "批土與研磨",
      "body": {
        "default": "大面積薄批，乾燥後以砂紙研磨，必要時重複。",
        "master": "薄批多次、逐道研磨。"
      },
      "waitTime": "每道批土需乾透"
    },
    {
      "order": 4,
      "title": "底漆",
      "body": {
        "default": "全面塗佈底漆（新粉刷牆面用抗鹼底漆）。"
      },
      "waitTime": "依產品乾燥時間"
    },
    {
      "order": 5,
      "title": "面漆",
      "body": {
        "default": "先用刷子沿牆角、邊緣刷一圈，再以滾筒大面積塗刷，共 2 道。",
        "beginner": "滾筒用「W」字形來回滾，比較均勻；每次沾漆不要太多，避免流下來。"
      },
      "waitTime": "兩道之間依產品乾燥時間"
    },
    {
      "order": 6,
      "title": "收尾",
      "body": {
        "default": "漆未完全乾時撕除遮蔽膠帶，裝回蓋板，清潔。"
      }
    }
  ],
  "materials": [
    {
      "name": "批土",
      "materialId": "wall-putty",
      "spec": "水性批土"
    },
    {
