      "qtyNote": "可用「油漆用量」計算機估算"
    },
    {
      "name": "遮蔽膠帶、保護膜"
    }
  ],
  "tools": [
    {
      "name": "滾筒、延長桿"
    },
    {
      "name": "油漆刷"
    },
    {
      "name": "刮刀"
    },
    {
      "name": "砂紙（磨板）"
    },
    {
      "name": "合梯"
    }
  ],
  "commonMistakes": [
    {
      "mistake": "沒有研磨就上漆",
      "consequence": "牆面粗糙、瑕疵明顯",
      "prevention": "批土後確實研磨"
    },
    {
      "mistake": "一次塗太厚",
      "consequence": "流垂、乾燥慢",
      "prevention": "薄塗多道"
    },
    {
      "mistake": "壁癌直接蓋漆",
      "consequence": "很快又剝落",
      "prevention": "先處理水源"
    },
    {
      "mistake": "膠帶太晚撕",
      "consequence": "把漆一起撕下來",
      "prevention": "漆半乾時撕"
    }
  ],
  "qcChecklist": [
    {
      "item": "平整度",
      "criteria": "側光下無明顯凹凸",
      "method": "手電筒斜照"
    },
    {
      "item": "色澤",
      "criteria": "均勻無色差、無透底",
      "method": "目視"
    },
    {
      "item": "邊緣",
      "criteria": "收邊整齊",
      "method": "目視"
    },
    {
      "item": "清潔",
      "criteria": "無滴漆污染",
      "method": "目視"
    }
  ],
  "safety": [
    {
      "level": "warning",
