  "difficulty": "master",
  "title": "分離式冷氣安裝",
  "summary": "室內機、室外機定位，冷媒配管、排水、抽真空與試機",
  "tradeIds": [
    "hvac"
  ],
  "overview": {
    "default": "依原廠規範決定室內外機位置，鑽孔配置冷媒管、排水管與電源，完成接管後抽真空、檢漏，開閥試機並確認排水順暢。",
    "beginner": "冷氣好不好用、會不會漏水，安裝佔很大因素。驗收時可以請師傅示範「抽真空」與排水測試。",
    "master": "定位 → 掛板 → 鑽孔（外低）→ 配管、排水、電源 → 擴口接管 → 抽真空 → 檢漏 → 開閥試機。"
  },
  "steps": [
    {
      "order": 1,
      "title": "定位",
      "body": {
        "default": "室內機避開直吹床鋪、預留上方與兩側維修空間；室外機放在通風、可維修、支架穩固的位置。"
      },
      "keyPoints": [
        "依原廠安裝手冊的距離要求",
        "室外機出風口前方不可被擋住"
      ]
    },
    {
      "order": 2,
      "title": "掛板與鑽孔",
      "body": {
        "default": "安裝室內機掛板並水平校正，穿牆孔內高外低，加裝套管。",
        "beginner": "穿牆孔要往外斜，才不會讓雨水倒灌、排水往內流。"
      }
    },
    {
      "order": 3,
      "title": "配管",
      "body": {
        "default": "冷媒銅管依原廠管徑配置，包覆保溫；排水管保持順向坡度，避免凹陷積水。",
        "master": "管徑依原廠；排水管全程順坡、不可有 U 形積水段。"
      },
      "keyPoints": [
        "銅管彎曲用彎管器，不可壓扁",
        "排水管出口不可泡在水裡"
      ]
    },
    {
      "order": 4,
      "title": "電源",
      "body": {
        "default": "使用專用迴路，線徑與開關依冷氣規格。",
        "beginner": "冷氣用電量大，要有自己專用的一路電，不要跟其他插座共用。"
      }
    },
    {
      "order": 5,
      "title": "擴口與接管",
      "body": {
        "default": "以擴口器擴口、扭力扳手鎖緊接頭。",
        "master": "擴口尺寸正確、依規定扭力鎖緊。"
      }
    },
    {
      "order": 6,
      "title": "抽真空與檢漏",
      "body": {
        "default": "以真空泵抽除管內空氣與水分，觀察真空錶保持不回升，接頭檢漏。",
        "beginner": "管子裡有空氣和水氣，冷氣會變不冷甚至損壞壓縮機，所以一定要抽真空。"
      },
      "specs": [
        {
          "label": "抽真空",
          "value": "依原廠規範（常見至少 15–30 分鐘，視管長）"
        }
      ]
    },
    {
      "order": 7,
      "title": "開閥試機",
      "body": {
        "default": "開啟室外機閥門，送電試機，量測出風溫度、運轉電流，倒水測試排水。"
      }
    }
  ],
