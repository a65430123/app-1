      "mistake": "沒有抽真空",
      "consequence": "冷房效果差、壓縮機故障",
      "prevention": "抽真空並觀察真空錶"
    },
    {
      "mistake": "排水管有凹段或倒坡",
      "consequence": "室內機滴水",
      "prevention": "全程順坡"
    },
