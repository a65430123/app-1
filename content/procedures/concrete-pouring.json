  "tags": [
    "結構",
    "混凝土",
    "灌漿"
  ],
  "difficulty": "intermediate",
  "title": "混凝土澆置與養護",
  "summary": "把預拌混凝土澆入模板、振動搗實並完成養護",
  "tradeIds": [
    "structure"
  ],
  "overview": {
    "default": "預拌混凝土到場後，經檢查與取樣，以泵浦車澆入模板，使用振動棒搗實、表面整平，並在之後一段期間內保濕養護。",
    "beginner": "俗稱「灌漿」。灌漿當天是整棟房子品質的關鍵之一，振動不足會有蜂窩（空洞），養護不足會裂。",
    "master": "澆置前檢查 → 進場驗收（坍度、試體）→ 分層澆置 → 振動搗實 → 整平粉光 → 濕養護。"
  },
  "steps": [
    {
      "order": 1,
      "title": "澆置前檢查",
      "body": {
        "default": "確認鋼筋、模板、預埋物都已查驗合格，清除模板內雜物，模板適度濕潤。"
      },
      "keyPoints": [
        "模板內的垃圾、木屑要清乾淨",
        "安排好人力、振動棒與備用機具"
      ]
    },
    {
      "order": 2,
      "title": "進場驗收與取樣",
      "body": {
        "default": "核對送貨單（強度、數量、出廠時間），做坍度試驗並依規定取樣製作圓柱試體。",
        "beginner": "坍度試驗是測混凝土「稀不稀」，圓柱試體會送去實驗室壓，確認強度夠不夠。"
      },
      "specs": [
        {
          "label": "坍度",
          "value": "依設計與施工規範"
        },
        {
          "label": "試體",
          "value": "依規範頻率取樣"
        }
      ],
      "keyPoints": [
        "現場不可任意加水"
      ]
    },
    {
      "order": 3,
      "title": "分層澆置",
      "body": {
        "default": "依順序（常見先柱牆、後樑版）分層澆置，避免一次倒太多造成側壓過大。",
        "master": "分層澆置，控制落差，避免析離。"
      },
      "keyPoints": [
        "落下高度過高時用導管，避免骨材分離"
      ]
    },
    {
      "order": 4,
      "title": "振動搗實",
      "body": {
        "default": "以振動棒垂直插入、逐點搗實，看到表面泛漿、不再冒氣泡即可拔出。",
        "beginner": "振動是把混凝土裡的空氣趕出來，讓它塞滿每個角落。",
        "master": "插點間距約 50 cm、垂直插入、緩拔；避免碰觸鋼筋與模板、勿用振動棒推送混凝土。"
      },
      "specs": [
        {
          "label": "插入間距（常見）",
          "value": "約 40–60 cm"
        },
        {
          "label": "時間",
          "value": "每點數秒至十數秒，泛漿即止"
        }
      ]
    },
    {
      "order": 5,
      "title": "整平與表面處理",
      "body": {
        "default": "以刮尺整平，依需要做粉光或刷毛。"
      }
    },
    {
      "order": 6,
      "title": "養護",
      "body": {
        "default": "終凝後開始灑水或覆蓋保濕，避免日曬強風。",
        "master": "濕養護一般至少 7 天（依規範與水泥種類）。"
      },
      "waitTime": "一般至少約 7 天"
    }
  ],
