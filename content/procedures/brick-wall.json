      "consequence": "砂漿失水、黏結不良",
      "prevention": "前一天澆水"
    },
    {
      "mistake": "一天砌太高",
      "consequence": "下方砂漿未硬化被壓壞、牆體變形",
      "prevention": "控制每日砌高"
    },
    {
      "mistake": "灰縫不飽滿",
      "consequence": "隔音差、易滲水、強度不足",
      "prevention": "灰縫填滿砂漿"
    },
    {
      "mistake": "頂部一次塞滿",
      "consequence": "牆頂裂縫",
      "prevention": "隔日再塞縫"
    }
  ],
