    },
    {
      "name": "紙筆或手機記錄"
    }
  ],
  "commonMistakes": [
    {
      "mistake": "自己拆開內部面板",
      "consequence": "觸電危險",
      "prevention": "只開外蓋，不碰內部"
    },
    {
      "mistake": "常跳電就換大一點的開關",
      "consequence": "電線過熱引起火災",
      "prevention": "找電匠檢查負載與線徑"
    },
    {
      "mistake": "從不測試漏電斷路器",
      "consequence": "失效也不知道",
      "prevention": "每月按一次測試鈕"
    }
  ],
