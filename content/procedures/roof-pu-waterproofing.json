  ],
  "safety": [
    {
      "level": "danger",
      "text": "屋頂周邊無女兒牆或高度不足時，須設置防墜措施。"
    },
    {
      "level": "warning",
      "text": "溶劑型產品施工時禁煙火、保持通風。"
    },
    {
      "level": "warning",
      "text": "夏季屋頂高溫，注意中暑。"
    }
  ],
