    },
    {
      "name": "濕膜厚度規"
    }
  ],
  "commonMistakes": [
    {
      "mistake": "基面未乾就施工",
      "consequence": "起泡、剝離",
      "prevention": "確認乾燥"
    },
    {
      "mistake": "膜厚不足",
      "consequence": "短期內滲漏",
      "prevention": "依設計膜厚並檢查"
    },
    {
      "mistake": "落水頭沒處理好",
      "consequence": "落水頭周邊漏水",
      "prevention": "加強層＋補強布"
    },
    {
      "mistake": "沒塗面漆",
      "consequence": "PU 層日曬劣化",
      "prevention": "塗耐候面漆"
    }
  ],
  "qcChecklist": [
    {
      "item": "膜面",
      "criteria": "連續、無針孔、無起泡",
