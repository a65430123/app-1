  "tags": [
    "泥作"
  ],
  "difficulty": "beginner",
  "title": "水泥砂漿用量",
  "summary": "依面積、厚度與配比估算水泥包數與砂量",
  "type": "calculator",
  "engine": "mortar",
  "inputs": [
    {
      "key": "area",
      "label": "施作面積",
      "unit": "m²",
      "kind": "number",
      "default": 10,
      "min": 0,
      "step": 0.1
    },
    {
      "key": "thickness",
      "label": "厚度",
      "unit": "cm",
      "kind": "number",
      "default": 2,
      "min": 0,
      "step": 0.1
    },
    {
      "key": "sandRatio",
      "label": "配比 1：n（砂的份數 n）",
      "unit": "",
      "kind": "number",
      "default": 3,
      "min": 1,
      "step": 0.5,
      "help": "例：1:3 填 3"
    },
    {
      "key": "waste",
      "label": "損耗率",
      "unit": "%",
      "kind": "number",
      "default": 10,
      "min": 0,
      "step": 1
    }
  ],
  "params": [
    {
      "key": "dryFactor",
      "label": "乾料體積係數",
      "value": 1.27,
      "note": "濕砂漿換算乾料體積，常用 1.25–1.33"
    },
    {
      "key": "cementDensity",
      "label": "水泥鬆散單位重",
      "value": 1440,
      "unit": "kg/m³"
    },
    {
      "key": "bagWeight",
      "label": "每包重量",
      "value": 50,
      "unit": "kg"
    }
  ],
  "formulaDisplay": [
    "砂漿體積 V = 面積 × 厚度 ÷ 100 × (1 + 損耗率)",
    "乾料體積 Vd = V × 乾料係數",
    "水泥體積 = Vd × 1 ÷ (1 + n)；砂體積 = Vd × n ÷ (1 + n)",
    "水泥包數 = 水泥體積 × 單位重 ÷ 每包重量"
  ],
  "notes": [
    "此為概估，實際依砂含水量、施工方式而異",
    "未計水量"
  ],
  "relatedProcedureIds": [
